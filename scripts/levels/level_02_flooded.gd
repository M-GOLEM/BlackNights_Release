extends LevelBase


func _build() -> void:
	LevelKit.build_sky(self, pal)
	LevelKit.add_parallax_city(self, pal, 31, 0.16, 900.0, 280, 430, false, false, -18)
	LevelKit.add_parallax_city(self, pal, 47, 0.42, 940.0, 340, 560, true, false, -16)
	LevelKit.add_scroll_strip(self, pal, 902.0, 0.82, 30, 9, 6)
	LevelKit.add_ground(self, 0, 900, 620, pal, 900, 3)
	LevelKit.add_ground(self, 1360, 2050, 620, pal, 900, 4)
	LevelKit.add_ground(self, 2650, level_width, 620, pal, 900, 5)
	LevelKit.add_ground(self, 900, 1360, 1320, pal, 400, 6)
	LevelKit.add_ground(self, 2050, 2650, 1040, pal, 400, 7)
	LevelKit.add_water(self, Rect2(900, 560, 460, 760), pal)
	LevelKit.add_water(self, Rect2(2050, 600, 600, 440), pal)
	LevelKit.add_platform(self, Rect2(2160, 496, 140, 40), pal, true)
	LevelKit.add_platform(self, Rect2(2410, 470, 140, 40), pal, true)

	var props := LevelKit.Batch.new()
	props.z_index = -1
	add_child(props)
	props.rect(Rect2(560, 500, 18, 120), pal["detail"])
	props.rect(Rect2(546, 486, 46, 16), pal["detail"])
	props.rect(Rect2(1440, 420, 14, 200), pal["detail"])
	props.rect(Rect2(1430, 406, 34, 14), pal["detail"])
	props.rect(Rect2(1820, 560, 120, 10), pal["detail"])
	props.rect(Rect2(1840, 540, 10, 80), pal["detail"])
	props.rect(Rect2(1960, 540, 10, 80), pal["detail"])
	props.rect(Rect2(2740, 505, 16, 115), pal["detail"])
	props.rect(Rect2(2900, 545, 90, 8), pal["detail"])
	props.flush()

	LevelKit.add_lamp(self, Vector2(420, 620), pal, 220, 1.0, true)
	LevelKit.add_lamp(self, Vector2(1640, 620), pal, 200, 1.0, true)
	LevelKit.add_lamp(self, Vector2(2880, 620), pal, 230, 1.0, true)
	LevelKit.add_glow(self, Vector2(1700, 260), pal["accent"], 2.4, 0.08, -14)
	LevelKit.add_fog(self, Vector2(1150, 540), Vector2(1500, 320), Color("#4c8890"), 0.1, -10)
	LevelKit.add_fog(self, Vector2(2450, 500), Vector2(1300, 260), Color("#3f7d86"), 0.09, -10)
	LevelKit.add_checkpoint(self, Vector2(1600, 604), pal)
	LevelKit.add_checkpoint(self, Vector2(2820, 604), pal)
	add_finish_marker()
	LevelKit.add_post_fx(self, pal, 0.6, 0.05, Color(0.0, 0.03, 0.045, 0.14))
	LevelKit.add_rain($Camera2D, Color(0.6, 0.8, 0.92, 0.36), 330)
	LevelKit.add_dust($Camera2D, Color(0.55, 0.9, 0.95, 0.16), 40)
